# ─────────────────────────────────────────────────────────────
# AutoPartsPro Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3001

# Database (from Supabase: Settings → Database → Connection String)
# Use the "Transaction" mode URL (port 6543) for queries
DATABASE_URL=

# Direct URL for Prisma migrations (Session mode, port 5432)
DIRECT_URL=

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Frontend URL (for CORS — must match exactly)
FRONTEND_URL=http://localhost:5173
