// prisma/schema.prisma
// Database schema for AutoPartsPro
// Managed by Prisma ORM — do not edit generated migration files

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  OWNER
  WORKER
}

enum PaymentMethod {
  CASH
  TRANSFER
  CREDIT
}

enum ActivityType {
  SALE
  STOCK
  AUTH
  PRICE
  CREDIT
}

enum ContactType {
  CUSTOMER
  SUPPLIER
}

enum CreditStatus {
  UNPAID
  PARTIAL
  PAID
}

// ─────────────────────────────────────────────
// USERS
// Stores all staff accounts (owner + workers)
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(WORKER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  sales        Sale[]
  activityLogs ActivityLog[]
  creditPayments CreditPayment[]

  @@map("users")
}

// ─────────────────────────────────────────────
// INVENTORY
// One row = one spare part SKU
// ─────────────────────────────────────────────

model Inventory {
  id            String   @id @default(uuid())
  name          String
  brand         String
  compatibility String
  costPrice     Decimal  @map("cost_price") @db.Decimal(10, 2)
  sellingPrice  Decimal  @map("selling_price") @db.Decimal(10, 2)
  stock         Int      @default(0)
  minStock      Int      @default(5) @map("min_stock")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  sales         SaleItem[]

  @@map("inventory")
}

// ─────────────────────────────────────────────
// SALES
// One row = one transaction (one customer visit)
// A sale can contain multiple products via SaleItem
// Immutable — never edited or deleted (audit trail)
// ─────────────────────────────────────────────

model Sale {
  id            String        @id @default(uuid())
  workerId      String        @map("worker_id")
  customer      String        @default("Walk-in")
  paymentMethod PaymentMethod @map("payment_method")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  worker        User          @relation(fields: [workerId], references: [id])
  items         SaleItem[]
  credit        Credit?

  @@map("sales")
}

// ─────────────────────────────────────────────
// SALE ITEMS
// One row = one product line within a sale
// Example: Sale #1001
//   ├── Brake Pad x2   → one SaleItem row
//   ├── Oil Filter x1  → one SaleItem row
//   └── Spark Plug x4  → one SaleItem row
//
// itemName and unitPrice are snapshots of the
// inventory at the time of sale — so the record
// stays accurate even if prices change later
// ─────────────────────────────────────────────

model SaleItem {
  id          String    @id @default(uuid())
  saleId      String    @map("sale_id")
  inventoryId String    @map("inventory_id")
  itemName    String    @map("item_name")
  unitPrice   Decimal   @map("unit_price") @db.Decimal(10, 2)
  quantity    Int
  amount      Decimal   @db.Decimal(10, 2)

  // Relations
  sale        Sale      @relation(fields: [saleId], references: [id])
  inventory   Inventory @relation(fields: [inventoryId], references: [id])

  @@map("sale_items")
}

// ─────────────────────────────────────────────
// ACTIVITY LOGS
// Append-only audit trail — written server-side
// on every significant action
// workerName is a snapshot so logs are accurate
// even if the user is later deleted
// ─────────────────────────────────────────────

model ActivityLog {
  id         String       @id @default(uuid())
  workerId   String       @map("worker_id")
  workerName String       @map("worker_name")
  action     String
  detail     String
  type       ActivityType
  createdAt  DateTime     @default(now()) @map("created_at")

  // Relations
  worker     User         @relation(fields: [workerId], references: [id])

  @@map("activity_logs")
}

// ─────────────────────────────────────────────
// EXPENSES
// Monthly operating costs (rent, salaries, etc.)
// Used by the Reports page for profit calculation
// ─────────────────────────────────────────────

// ─────────────────────────────────────────────
// CREDITS
// Created automatically when a sale uses CREDIT payment.
// Tracks how much has been paid and outstanding balance.
// ─────────────────────────────────────────────

model Credit {
  id           String          @id @default(uuid())
  saleId       String          @unique @map("sale_id")
  customerName String          @map("customer_name")
  totalAmount  Decimal         @map("total_amount") @db.Decimal(10, 2)
  paidAmount   Decimal         @default(0) @map("paid_amount") @db.Decimal(10, 2)
  status       CreditStatus    @default(UNPAID)
  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  // Relations
  sale         Sale            @relation(fields: [saleId], references: [id])
  payments     CreditPayment[]

  @@map("credits")
}

// ─────────────────────────────────────────────
// CREDIT PAYMENTS
// Each row is one partial or full payment against a credit.
// ─────────────────────────────────────────────

model CreditPayment {
  id            String        @id @default(uuid())
  creditId      String        @map("credit_id")
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @map("payment_method")
  note          String?
  recordedById  String        @map("recorded_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  credit        Credit        @relation(fields: [creditId], references: [id])
  recordedBy    User          @relation(fields: [recordedById], references: [id])

  @@map("credit_payments")
}

model Contact {
  id          String      @id @default(uuid())
  type        ContactType
  name        String
  phone       String
  email       String?
  companyName String?     @map("company_name")
  address     String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("contacts")
}

model BankAccount {
  id                String   @id @default(uuid())
  bankName          String   @map("bank_name")
  accountHolderName String   @map("account_holder_name")
  accountNumber     String   @map("account_number")
  ifscRoutingCode   String   @map("ifsc_routing_code")
  isActive          Boolean  @default(false) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("bank_accounts")
}

model Expense {
  id        String   @id @default(uuid())
  category  String
  amount    Decimal  @db.Decimal(10, 2)
  month     Int      // 1–12
  year      Int
  createdAt DateTime @default(now()) @map("created_at")

  @@map("expenses")
}
