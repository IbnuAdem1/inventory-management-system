// prisma/schema.prisma
// Database schema for AutoPartsPro
// Managed by Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  OWNER
  WORKER
}

enum PaymentMethod {
  CASH
  TRANSFER
  CREDIT
}

enum ActivityType {
  SALE
  STOCK
  AUTH
  PRICE
  CREDIT
  USER
  TRANSFER
  BRANCH
  EXPENSE
}

enum ContactType {
  CUSTOMER
  SUPPLIER
}

enum CreditStatus {
  UNPAID
  PARTIAL
  PAID
}

// ─────────────────────────────────────────────
// BRANCHES
// Multi-store support (e.g. Main Store & Branch 2)
// ─────────────────────────────────────────────

model Branch {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  address     String?
  phone       String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  users           User[]
  sales           Sale[]
  branchStock     InventoryBranchStock[]
  transfersFrom   StockTransfer[]        @relation("FromBranch")
  transfersTo     StockTransfer[]        @relation("ToBranch")

  @@map("branches")
}

// ─────────────────────────────────────────────
// USERS
// Stores all staff accounts (owner + workers)
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(WORKER)
  branchId     String?  @map("branch_id")
  permissions  String[] @default(["sales", "inventory"])
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  branch                  Branch?                  @relation(fields: [branchId], references: [id])
  sales                   Sale[]
  activityLogs            ActivityLog[]
  creditPayments          CreditPayment[]
  stockTransfers          StockTransfer[]
  notificationPreferences NotificationPreferences?

  @@map("users")
}

// ─────────────────────────────────────────────
// NOTIFICATION PREFERENCES
// ─────────────────────────────────────────────

model NotificationPreferences {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  lowStockAlert      Boolean  @default(true) @map("low_stock_alert")
  dailySummary       Boolean  @default(true) @map("daily_summary")
  creditOverdueAlert Boolean  @default(true) @map("credit_overdue_alert")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ─────────────────────────────────────────────
// INVENTORY
// One row = one spare part SKU
// ─────────────────────────────────────────────

model Inventory {
  id             String   @id @default(uuid())
  name           String
  brand          String
  compatibility  String
  category       String   @default("General")
  sku            String?
  costPrice      Decimal  @map("cost_price") @db.Decimal(10, 2)
  sellingPrice   Decimal  @map("selling_price") @db.Decimal(10, 2)
  stock          Int      @default(0)
  minStock       Int      @default(5) @map("min_stock")
  registeredDate DateTime @default(now()) @map("registered_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  sales          SaleItem[]
  branchStock    InventoryBranchStock[]
  stockTransfers StockTransfer[]

  @@map("inventory")
}

// ─────────────────────────────────────────────
// INVENTORY BRANCH STOCK
// Tracks item stock individually per branch
// ─────────────────────────────────────────────

model InventoryBranchStock {
  id          String   @id @default(uuid())
  inventoryId String   @map("inventory_id")
  branchId    String   @map("branch_id")
  stock       Int      @default(0)
  minStock    Int      @default(5) @map("min_stock")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, branchId])
  @@map("inventory_branch_stock")
}

// ─────────────────────────────────────────────
// STOCK TRANSFERS
// Logs movements of parts between Branch 1 & Branch 2
// ─────────────────────────────────────────────

model StockTransfer {
  id           String   @id @default(uuid())
  inventoryId  String   @map("inventory_id")
  fromBranchId String   @map("from_branch_id")
  toBranchId   String   @map("to_branch_id")
  quantity     Int
  workerId     String   @map("worker_id")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  inventory  Inventory @relation(fields: [inventoryId], references: [id])
  fromBranch Branch    @relation("FromBranch", fields: [fromBranchId], references: [id])
  toBranch   Branch    @relation("ToBranch", fields: [toBranchId], references: [id])
  worker     User      @relation(fields: [workerId], references: [id])

  @@map("stock_transfers")
}

// ─────────────────────────────────────────────
// SALES
// One row = one transaction (one customer visit)
// ─────────────────────────────────────────────

model Sale {
  id            String        @id @default(uuid())
  workerId      String        @map("worker_id")
  branchId      String?       @map("branch_id")
  customer      String        @default("Walk-in")
  paymentMethod PaymentMethod @map("payment_method")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  bankAccountId String?       @map("bank_account_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  worker      User         @relation(fields: [workerId], references: [id])
  branch      Branch?      @relation(fields: [branchId], references: [id])
  items       SaleItem[]
  credit      Credit?
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])

  @@map("sales")
}

// ─────────────────────────────────────────────
// SALE ITEMS
// ─────────────────────────────────────────────

model SaleItem {
  id          String    @id @default(uuid())
  saleId      String    @map("sale_id")
  inventoryId String    @map("inventory_id")
  itemName    String    @map("item_name")
  unitPrice   Decimal   @map("unit_price") @db.Decimal(10, 2)
  quantity    Int
  amount      Decimal   @db.Decimal(10, 2)

  // Relations
  sale      Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  inventory Inventory @relation(fields: [inventoryId], references: [id])

  @@map("sale_items")
}

// ─────────────────────────────────────────────
// ACTIVITY LOGS
// ─────────────────────────────────────────────

model ActivityLog {
  id         String       @id @default(uuid())
  workerId   String       @map("worker_id")
  workerName String       @map("worker_name")
  action     String
  detail     String
  type       ActivityType
  createdAt  DateTime     @default(now()) @map("created_at")

  // Relations
  worker User @relation(fields: [workerId], references: [id])

  @@map("activity_logs")
}

// ─────────────────────────────────────────────
// CREDITS
// ─────────────────────────────────────────────

model Credit {
  id           String          @id @default(uuid())
  saleId       String          @unique @map("sale_id")
  customerName String          @map("customer_name")
  totalAmount  Decimal         @map("total_amount") @db.Decimal(10, 2)
  paidAmount   Decimal         @default(0) @map("paid_amount") @db.Decimal(10, 2)
  status       CreditStatus    @default(UNPAID)
  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  // Relations
  sale     Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  payments CreditPayment[]

  @@map("credits")
}

// ─────────────────────────────────────────────
// CREDIT PAYMENTS
// ─────────────────────────────────────────────

model CreditPayment {
  id            String        @id @default(uuid())
  creditId      String        @map("credit_id")
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @map("payment_method")
  note          String?
  recordedById  String        @map("recorded_by_id")
  bankAccountId String?       @map("bank_account_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  credit      Credit       @relation(fields: [creditId], references: [id], onDelete: Cascade)
  recordedBy  User         @relation(fields: [recordedById], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])

  @@map("credit_payments")
}

// ─────────────────────────────────────────────
// CONTACTS
// ─────────────────────────────────────────────

model Contact {
  id          String      @id @default(uuid())
  type        ContactType
  name        String
  phone       String
  email       String?
  companyName String?     @map("company_name")
  address     String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("contacts")
}

// ─────────────────────────────────────────────
// BANK ACCOUNTS
// ─────────────────────────────────────────────

model BankAccount {
  id                String   @id @default(uuid())
  bankName          String   @map("bank_name")
  accountHolderName String   @map("account_holder_name")
  accountNumber     String   @map("account_number")
  ifscRoutingCode   String   @map("ifsc_routing_code")
  isActive          Boolean  @default(false) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  sales          Sale[]
  creditPayments CreditPayment[]

  @@map("bank_accounts")
}

// ─────────────────────────────────────────────
// EXPENSES
// ─────────────────────────────────────────────

model Expense {
  id        String   @id @default(uuid())
  category  String
  amount    Decimal  @db.Decimal(10, 2)
  month     Int      // 1–12
  year      Int
  branchId  String?  @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("expenses")
}
